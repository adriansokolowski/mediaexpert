APP_NAME="Appointment Scheduling"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Instants are stored in UTC; the location's own timezone decides how the
# opening hours are interpreted.
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# The Docker setup points at the bundled MySQL service.
# For a zero-dependency local run use:
#   DB_CONNECTION=sqlite
#   DB_DATABASE=/absolute/path/to/database/database.sqlite
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=scheduling
DB_USERNAME=scheduling
DB_PASSWORD=secret

# No users, no sessions and no queue workers in this project.
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log

# Business configuration used when seeding a location.
SCHEDULING_DEFAULT_LOCATION=main
SCHEDULING_TIMEZONE=Europe/Warsaw
SCHEDULING_SLOT_DURATION=30

# Shared secret required by the administrative closing-day endpoints.
# Leave empty to disable those endpoints entirely.
SCHEDULING_ADMIN_TOKEN=local-admin-token
